// File: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Bisa diganti ke "postgresql" saat rilis produksi
}

// ==========================================
// 1. MODUL SAAS & ONBOARDING (Kunci Keamanan Multi-Tenant)
// ==========================================
model Company {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  industry    String
  timezone    String   @default("Asia/Makassar")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi: Satu perusahaan memiliki banyak data di bawah ini
  users           User[]
  clients         Client[]
  employees       Employee[]
  locations       Location[]
  jobs            Job[]
  vendors         Vendor[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String   // Di-hash untuk login
  role        String   // "SUPER_ADMIN", "SALES", "SUPERVISOR"
  
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 2. MODUL CRM PIPELINE (Sisi Bisnis & Klien)
// ==========================================
model Client {
  id          String   @id @default(cuid())
  name        String
  industry    String
  status      String   @default("PROSPECT") // PROSPECT, SURVEY, NEGOTIATION, DEAL_WON

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobs        Job[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// 3. MODUL HR & FIELDOPS (Sisi Pekerja)
// ==========================================
model Employee {
  id            String   @id @default(cuid())
  name          String
  role          String   // Contoh: Teknisi, Kurir, Cleaning Service
  baseCapacity  Int      @default(100) // Metrik awal untuk AI Workload Score
  
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobs          Job[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Location {
  id             String   @id @default(cuid())
  name           String
  coordinates    String   // Format: "latitude,longitude"
  
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  historicalJobs Job[]
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 4. MODUL WORKPULSE & FIELDOPS (Sisi Operasional)
// ==========================================
model Job {
  id             String   @id @default(cuid())
  title          String
  status         String   @default("CREATED") 
  // CREATED -> DISPATCHED -> CHECKED_IN -> COMPLETED -> VERIFIED
  
  // Metrik Waktu (Data Utama untuk AI Copilot)
  assignedDate   DateTime @default(now())
  deadline       DateTime
  checkInTime    DateTime?
  completedTime  DateTime?
  
  // Relasi Multi-Tenant
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Relasi Data 
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  
  employeeId     String?  // Bisa kosong jika baru deal di CRM dan AI belum membagi tugas
  employee       Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  locationId     String
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  
  // Data Mentah Lapangan (FieldOps App)
  gpsRawData     String?   
  proofImageUrl  String?
  clientRating   Int?      // Rating kepuasan klien 1-5
  feedbackNote   String?   // Catatan klien
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// 5. MODUL VENDORFLOW (Sisi Suplai)
// ==========================================
model Vendor {
  id          String   @id @default(cuid())
  name        String
  serviceType String
  score       Float    @default(0) // Skor performa AI

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contracts   VendorContract[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VendorContract {
  id           String   @id @default(cuid())
  title        String
  deadline     DateTime
  deliveryDate DateTime?
  qualityScore Int?      // Penilaian kualitas (1-100)
  priceScore   Int?      // Penilaian harga (1-100)

  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}