generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ==========================================
// 0. MULTI-TENANCY & KONFIGURASI (NEW)
// ... (Biarkan kode model ke bawah tetap sama)

// ==========================================
// 0. MULTI-TENANCY & KONFIGURASI (NEW)
// ==========================================
model Company {
  id          String   @id @default(cuid())
  name        String
  industry    String
  size        String?
  address     String?
  logoName    String?
  logoUrl     String?
  timezone    String   @default("Asia/Makassar")
  workingDays String   @default("Senin - Jumat")
  createdAt   DateTime @default(now())

  // Relasi Data (Isolasi per perusahaan)
  admins    Admin[]
  divisions Division[]
  employees Employee[]
  clients   Client[]
  jobs      Job[]
}

model Admin {
  id        String  @id @default(cuid())
  name      String
  email     String  @unique
  phone     String
  password  String // Nanti akan di-hash
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Division {
  id        String     @id @default(cuid())
  name      String
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[] // Karyawan mana saja yang masuk divisi ini
}

// ==========================================
// 1. MODUL CRM (Sisi Bisnis & Klien)
// ==========================================
model Client {
  id        String   @id @default(cuid())
  name      String
  industry  String
  status    String   @default("PROSPECT")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs      Job[]
  createdAt DateTime @default(now())
}

// ==========================================
// 2. MODUL HR & FIELDOPS (Sisi Pekerja)
// ==========================================
model Employee {
  id   String @id @default(cuid())
  name String

  // Sekarang role diganti jadi relasi ke tabel Division
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  baseCapacity Int      @default(100)
  jobs         Job[]
  createdAt    DateTime @default(now())
}

model Location {
  id             String @id @default(cuid())
  name           String
  coordinates    String
  historicalJobs Job[]
}

// ==========================================
// 3. MODUL WORKPULSE & FIELDOPS (Sisi Operasional)
// ==========================================
model Job {
  id     String @id @default(cuid())
  title  String
  status String @default("CREATED")

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedDate  DateTime  @default(now())
  deadline      DateTime
  checkInTime   DateTime?
  completedTime DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  gpsRawData    String?
  proofImageUrl String?
  clientRating  Int?
  feedbackNote  String?
}

// ==========================================
// 4. MODUL VENDORFLOW (Sisi Suplai)
// ==========================================
model Vendor {
  id          String           @id @default(cuid())
  name        String
  serviceType String
  score       Float            @default(0)
  contracts   VendorContract[]
}

model VendorContract {
  id           String    @id @default(cuid())
  title        String
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  deadline     DateTime
  deliveryDate DateTime?
  qualityScore Int?
  priceScore   Int?
}
